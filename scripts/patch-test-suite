#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 TEST-SUITE-DIR" >&2
  exit 2
fi

repo_root=$(cd "$(dirname "$0")/.." && pwd)
suite_dir=$1
patch_file="$repo_root/scripts/clojure-test-suite.patch"

if git -C "$suite_dir" apply --check "$patch_file" 2>/dev/null; then
  git -C "$suite_dir" apply "$patch_file"
elif git -C "$suite_dir" apply --reverse --check "$patch_file" 2>/dev/null; then
  :
else
  echo "cannot apply $patch_file cleanly to $suite_dir" >&2
  exit 1
fi
