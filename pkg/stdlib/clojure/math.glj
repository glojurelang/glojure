(ns
  ^{:author "Alex Miller",
    :doc "Clojure wrapper functions for java.lang.Math static methods.

  Function calls are inlined for performance, and type hinted for primitive
  long or double parameters where appropriate. In general, Math methods are
  optimized for performance and have bounds for error tolerance. If
  greater precision is needed, use java.lang.StrictMath directly instead.

  For more complete information, see:
  https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html"}
  clojure.math)

(set! *warn-on-reflection* true)

(def
  ^{:doc "Constant for e, the base for natural logarithms.
  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#E"
    :added "1.11"
    :const true
    :tag 'double}
  E
  github.com:glojurelang:glojure:pkg:javacompat:math.E)

(def
  ^{:doc "Constant for pi, the ratio of the circumference of a circle to its diameter.
  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#PI"
    :added "1.11"
    :const true
    :tag 'double}
  PI
  github.com:glojurelang:glojure:pkg:javacompat:math.PI)

(defn sin {:doc "Returns the sine of an angle.\n  If a is ##NaN, ##-Inf, ##Inf => ##NaN\n  If a is zero => zero with the same sign as a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#sin-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Sin (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Sin a)))

(defn cos {:doc "Returns the cosine of an angle.\n  If a is ##NaN, ##-Inf, ##Inf => ##NaN\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#cos-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Cos (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Cos a)))

(defn tan {:doc "Returns the tangent of an angle.\n  If a is ##NaN, ##-Inf, ##Inf => ##NaN\n  If a is zero => zero with the same sign as a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#tan-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Tan (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Tan a)))

(defn asin {:doc "Returns the arc sine of an angle, in the range -pi/2 to pi/2.\n  If a is ##NaN or |a|>1 => ##NaN\n  If a is zero => zero with the same sign as a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#asin-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Asin (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Asin a)))

(defn acos {:doc "Returns the arc cosine of a, in the range 0.0 to pi.\n  If a is ##NaN or |a|>1 => ##NaN\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#acos-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Acos (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Acos a)))

(defn atan {:doc "Returns the arc tangent of a, in the range of -pi/2 to pi/2.\n  If a is ##NaN => ##NaN\n  If a is zero => zero with the same sign as a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#atan-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Atan (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Atan a)))

(defn to-radians {:doc "Converts an angle in degrees to an approximate equivalent angle in radians.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#toRadians-double-", :inline-arities #{1}, :inline (fn [deg] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.ToRadians (double (clojure.core/unquote deg))))), :added "1.11"} ^{:tag double} [^{:tag double} deg] (let [^{:tag double} deg (double ^{:tag double} deg)] (github.com:glojurelang:glojure:pkg:javacompat:math.ToRadians deg)))

(defn to-degrees {:doc "Converts an angle in radians to an approximate equivalent angle in degrees.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#toDegrees-double-", :inline-arities #{1}, :inline (fn [r] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.ToDegrees (double (clojure.core/unquote r))))), :added "1.11"} ^{:tag double} [^{:tag double} r] (let [^{:tag double} r (double ^{:tag double} r)] (github.com:glojurelang:glojure:pkg:javacompat:math.ToDegrees r)))

(defn exp {:doc "Returns Euler's number e raised to the power of a.\n  If a is ##NaN => ##NaN\n  If a is ##Inf => ##Inf\n  If a is ##-Inf => +0.0\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#exp-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Exp (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Exp a)))

(defn log {:doc "Returns the natural logarithm (base e) of a.\n  If a is ##NaN or negative => ##NaN\n  If a is ##Inf => ##Inf\n  If a is zero => ##-Inf\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#log-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Log (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Log a)))

(defn log10 {:doc "Returns the logarithm (base 10) of a.\n  If a is ##NaN or negative => ##NaN\n  If a is ##Inf => ##Inf\n  If a is zero => ##-Inf\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#log10-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Log10 (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Log10 a)))

(defn sqrt {:doc "Returns the positive square root of a.\n  If a is ##NaN or negative => ##NaN\n  If a is ##Inf => ##Inf\n  If a is zero => a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#sqrt-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Sqrt (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Sqrt a)))

(defn cbrt {:doc "Returns the cube root of a.\n  If a is ##NaN => ##NaN\n  If a is ##Inf or ##-Inf => a\n  If a is zero => zero with sign matching a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#cbrt-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Cbrt (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Cbrt a)))

(defn IEEE-remainder {:doc "Returns the remainder per IEEE 754 such that\n    remainder = dividend - divisor * n\n  where n is the integer closest to the exact value of dividend / divisor.\n  If two integers are equally close, then n is the even one.\n  If the remainder is zero, sign will match dividend.\n  If dividend or divisor is ##NaN, or dividend is ##Inf or ##-Inf, or divisor is zero => ##NaN\n  If dividend is finite and divisor is infinite => dividend\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#IEEEremainder-double-double-", :inline-arities #{2}, :inline (fn [dividend divisor] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.IEEEremainder (double (clojure.core/unquote dividend)) (double (clojure.core/unquote divisor))))), :added "1.11"} ^{:tag double} [^{:tag double} dividend ^{:tag double} divisor] (let [^{:tag double} dividend (double ^{:tag double} dividend) ^{:tag double} divisor (double ^{:tag double} divisor)] (github.com:glojurelang:glojure:pkg:javacompat:math.IEEEremainder dividend divisor)))

(defn ceil {:doc "Returns the smallest double greater than or equal to a, and equal to a\n  mathematical integer.\n  If a is ##NaN or ##Inf or ##-Inf or already equal to an integer => a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#ceil-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Ceil (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Ceil a)))

(defn floor {:doc "Returns the largest double less than or equal to a, and equal to a\n  mathematical integer.\n  If a is ##NaN or ##Inf or ##-Inf or already equal to an integer => a\n  If a is less than zero but greater than -1.0 => -0.0\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#floor-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Floor (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Floor a)))

(defn rint {:doc "Returns the double closest to a and equal to a mathematical integer.\n  If two values are equally close, return the even one.\n  If a is ##NaN or ##Inf or ##-Inf or zero => a\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#rint-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Rint (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag double} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Rint a)))

(defn atan2 {:doc "Returns the angle theta from the conversion of rectangular coordinates (x, y) to polar coordinates (r, theta).\n  Computes the phase theta by computing an arc tangent of y/x in the range of -pi to pi.\n  For more details on special cases, see:\n  https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#atan2-double-double-", :inline-arities #{2}, :inline (fn [y x] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Atan2 (double (clojure.core/unquote y)) (double (clojure.core/unquote x))))), :added "1.11"} ^{:tag double} [^{:tag double} y ^{:tag double} x] (let [^{:tag double} y (double ^{:tag double} y) ^{:tag double} x (double ^{:tag double} x)] (github.com:glojurelang:glojure:pkg:javacompat:math.Atan2 y x)))

(defn pow {:doc "Returns the value of a raised to the power of b.\n  For more details on special cases, see:\n  https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#pow-double-double-", :inline-arities #{2}, :inline (fn [a b] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Pow (double (clojure.core/unquote a)) (double (clojure.core/unquote b))))), :added "1.11"} ^{:tag double} [^{:tag double} a ^{:tag double} b] (let [^{:tag double} a (double ^{:tag double} a) ^{:tag double} b (double ^{:tag double} b)] (github.com:glojurelang:glojure:pkg:javacompat:math.Pow a b)))

(defn round {:doc "Returns the closest long to a. If equally close to two values, return the one\n  closer to ##Inf.\n  If a is ##NaN => 0\n  If a is ##-Inf or < Long/MIN_VALUE => Long/MIN_VALUE\n  If a is ##Inf or > Long/MAX_VALUE => Long/MAX_VALUE\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#round-double-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Round (double (clojure.core/unquote a))))), :added "1.11"} ^{:tag long} [^{:tag double} a] (let [^{:tag double} a (double ^{:tag double} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.Round a)))

(defn random
  {:doc "Returns a positive double between 0.0 and 1.0, chosen pseudorandomly with
  approximately random distribution.
  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#random--"
   :inline-arities #{0}
   :inline (fn [] `(github.com:glojurelang:glojure:pkg:javacompat:math.Random))
   :added "1.11"}
  ^double []
  (github.com:glojurelang:glojure:pkg:javacompat:math.Random))

(defn add-exact {:doc "Returns the sum of x and y, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#addExact-long-long-", :inline-arities #{2}, :inline (fn [x y] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.AddExact (long (clojure.core/unquote x)) (long (clojure.core/unquote y))))), :added "1.11"} ^{:tag long} [^{:tag long} x ^{:tag long} y] (let [^{:tag long} x (long ^{:tag long} x) ^{:tag long} y (long ^{:tag long} y)] (github.com:glojurelang:glojure:pkg:javacompat:math.AddExact x y)))

(defn subtract-exact {:doc "Returns the difference of x and y, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#subtractExact-long-long-", :inline-arities #{2}, :inline (fn [x y] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.SubtractExact (long (clojure.core/unquote x)) (long (clojure.core/unquote y))))), :added "1.11"} ^{:tag long} [^{:tag long} x ^{:tag long} y] (let [^{:tag long} x (long ^{:tag long} x) ^{:tag long} y (long ^{:tag long} y)] (github.com:glojurelang:glojure:pkg:javacompat:math.SubtractExact x y)))

(defn multiply-exact {:doc "Returns the product of x and y, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#multiplyExact-long-long-", :inline-arities #{2}, :inline (fn [x y] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.MultiplyExact (long (clojure.core/unquote x)) (long (clojure.core/unquote y))))), :added "1.11"} ^{:tag long} [^{:tag long} x ^{:tag long} y] (let [^{:tag long} x (long ^{:tag long} x) ^{:tag long} y (long ^{:tag long} y)] (github.com:glojurelang:glojure:pkg:javacompat:math.MultiplyExact x y)))

(defn increment-exact {:doc "Returns a incremented by 1, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#incrementExact-long-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.IncrementExact (long (clojure.core/unquote a))))), :added "1.11"} ^{:tag long} [^{:tag long} a] (let [^{:tag long} a (long ^{:tag long} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.IncrementExact a)))

(defn decrement-exact {:doc "Returns a decremented by 1, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#decrementExact-long-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.DecrementExact (long (clojure.core/unquote a))))), :added "1.11"} ^{:tag long} [^{:tag long} a] (let [^{:tag long} a (long ^{:tag long} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.DecrementExact a)))

(defn negate-exact {:doc "Returns the negation of a, throws ArithmeticException on overflow.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#negateExact-long-", :inline-arities #{1}, :inline (fn [a] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.NegateExact (long (clojure.core/unquote a))))), :added "1.11"} ^{:tag long} [^{:tag long} a] (let [^{:tag long} a (long ^{:tag long} a)] (github.com:glojurelang:glojure:pkg:javacompat:math.NegateExact a)))

(defn floor-div {:doc "Integer division that rounds to negative infinity (as opposed to zero).\n  The special case (floorDiv Long/MIN_VALUE -1) overflows and returns Long/MIN_VALUE.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#floorDiv-long-long-", :inline-arities #{2}, :inline (fn [x y] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.FloorDiv (long (clojure.core/unquote x)) (long (clojure.core/unquote y))))), :added "1.11"} ^{:tag long} [^{:tag long} x ^{:tag long} y] (let [^{:tag long} x (long ^{:tag long} x) ^{:tag long} y (long ^{:tag long} y)] (github.com:glojurelang:glojure:pkg:javacompat:math.FloorDiv x y)))

(defn floor-mod {:doc "Integer modulus x - (floorDiv(x, y) * y). Sign matches y and is in the\n  range -|y| < r < |y|.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#floorMod-long-long-", :inline-arities #{2}, :inline (fn [x y] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.FloorMod (long (clojure.core/unquote x)) (long (clojure.core/unquote y))))), :added "1.11"} ^{:tag long} [^{:tag long} x ^{:tag long} y] (let [^{:tag long} x (long ^{:tag long} x) ^{:tag long} y (long ^{:tag long} y)] (github.com:glojurelang:glojure:pkg:javacompat:math.FloorMod x y)))

(defn ulp {:doc "Returns the size of an ulp (unit in last place) for d.\n  If d is ##NaN => ##NaN\n  If d is ##Inf or ##-Inf => ##Inf\n  If d is zero => Double/MIN_VALUE\n  If d is +/- Double/MAX_VALUE => 2^971\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#ulp-double-", :inline-arities #{1}, :inline (fn [d] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Ulp (double (clojure.core/unquote d))))), :added "1.11"} ^{:tag double} [^{:tag double} d] (let [^{:tag double} d (double ^{:tag double} d)] (github.com:glojurelang:glojure:pkg:javacompat:math.Ulp d)))

(defn signum {:doc "Returns the signum function of d - zero for zero, 1.0 if >0, -1.0 if <0.\n  If d is ##NaN => ##NaN\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#signum-double-", :inline-arities #{1}, :inline (fn [d] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Signum (double (clojure.core/unquote d))))), :added "1.11"} ^{:tag double} [^{:tag double} d] (let [^{:tag double} d (double ^{:tag double} d)] (github.com:glojurelang:glojure:pkg:javacompat:math.Signum d)))

(defn sinh {:doc "Returns the hyperbolic sine of x, (e^x - e^-x)/2.\n  If x is ##NaN => ##NaN\n  If x is ##Inf or ##-Inf or zero => x\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#sinh-double-", :inline-arities #{1}, :inline (fn [x] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Sinh (double (clojure.core/unquote x))))), :added "1.11"} ^{:tag double} [^{:tag double} x] (let [^{:tag double} x (double ^{:tag double} x)] (github.com:glojurelang:glojure:pkg:javacompat:math.Sinh x)))

(defn cosh {:doc "Returns the hyperbolic cosine of x, (e^x + e^-x)/2.\n  If x is ##NaN => ##NaN\n  If x is ##Inf or ##-Inf => ##Inf\n  If x is zero => 1.0\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#cosh-double-", :inline-arities #{1}, :inline (fn [x] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Cosh (double (clojure.core/unquote x))))), :added "1.11"} ^{:tag double} [^{:tag double} x] (let [^{:tag double} x (double ^{:tag double} x)] (github.com:glojurelang:glojure:pkg:javacompat:math.Cosh x)))

(defn tanh {:doc "Returns the hyperbolic tangent of x, sinh(x)/cosh(x).\n  If x is ##NaN => ##NaN\n  If x is zero => zero, with same sign\n  If x is ##Inf => +1.0\n  If x is ##-Inf => -1.0\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#tanh-double-", :inline-arities #{1}, :inline (fn [x] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Tanh (double (clojure.core/unquote x))))), :added "1.11"} ^{:tag double} [^{:tag double} x] (let [^{:tag double} x (double ^{:tag double} x)] (github.com:glojurelang:glojure:pkg:javacompat:math.Tanh x)))

(defn hypot {:doc "Returns sqrt(x^2 + y^2) without intermediate underflow or overflow.\n  If x or y is ##Inf or ##-Inf => ##Inf\n  If x or y is ##NaN and neither is ##Inf or ##-Inf => ##NaN\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#hypot-double-double-", :inline-arities #{2}, :inline (fn [x y] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Hypot (double (clojure.core/unquote x)) (double (clojure.core/unquote y))))), :added "1.11"} ^{:tag double} [^{:tag double} x ^{:tag double} y] (let [^{:tag double} x (double ^{:tag double} x) ^{:tag double} y (double ^{:tag double} y)] (github.com:glojurelang:glojure:pkg:javacompat:math.Hypot x y)))

(defn expm1 {:doc "Returns e^x - 1. Near 0, expm1(x)+1 is more accurate to e^x than exp(x).\n  If x is ##NaN => ##NaN\n  If x is ##Inf => #Inf\n  If x is ##-Inf => -1.0\n  If x is zero => x\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#expm1-double-", :inline-arities #{1}, :inline (fn [x] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Expm1 (double (clojure.core/unquote x))))), :added "1.11"} ^{:tag double} [^{:tag double} x] (let [^{:tag double} x (double ^{:tag double} x)] (github.com:glojurelang:glojure:pkg:javacompat:math.Expm1 x)))

(defn log1p {:doc "Returns ln(1+x). For small values of x, log1p(x) is more accurate than\n  log(1.0+x).\n  If x is ##NaN or < -1 => ##NaN\n  If x is ##Inf => ##Inf\n  If x is -1 => ##-Inf\n  If x is 0 => 0 with sign matching x\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#log1p-double-", :inline-arities #{1}, :inline (fn [x] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Log1p (double (clojure.core/unquote x))))), :added "1.11"} ^{:tag double} [^{:tag double} x] (let [^{:tag double} x (double ^{:tag double} x)] (github.com:glojurelang:glojure:pkg:javacompat:math.Log1p x)))

(defn copy-sign {:doc "Returns a double with the magnitude of the first argument and the sign of\n  the second.\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#copySign-double-double-", :inline-arities #{2}, :inline (fn [magnitude sign] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.CopySign (double (clojure.core/unquote magnitude)) (double (clojure.core/unquote sign))))), :added "1.11"} ^{:tag double} [^{:tag double} magnitude ^{:tag double} sign] (let [^{:tag double} magnitude (double ^{:tag double} magnitude) ^{:tag double} sign (double ^{:tag double} sign)] (github.com:glojurelang:glojure:pkg:javacompat:math.CopySign magnitude sign)))

(defn get-exponent {:doc "Returns the exponent of d.\n  If d is ##NaN, ##Inf, ##-Inf => Double/MAX_EXPONENT + 1\n  If d is zero or subnormal => Double/MIN_EXPONENT - 1\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#getExponent-double-", :inline-arities #{1}, :inline (fn [d] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.GetExponent (double (clojure.core/unquote d))))), :added "1.11"} [^{:tag double} d] (let [^{:tag double} d (double ^{:tag double} d)] (github.com:glojurelang:glojure:pkg:javacompat:math.GetExponent d)))

(defn next-after {:doc "Returns the adjacent floating point number to start in the direction of\n  the second argument. If the arguments are equal, the second is returned.\n  If either arg is #NaN => #NaN\n  If both arguments are signed zeros => direction\n  If start is +-Double/MIN_VALUE and direction would cause a smaller magnitude\n    => zero with sign matching start\n  If start is ##Inf or ##-Inf and direction would cause a smaller magnitude\n    => Double/MAX_VALUE with same sign as start\n  If start is equal to +=Double/MAX_VALUE and direction would cause a larger magnitude\n    => ##Inf or ##-Inf with sign matching start\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#nextAfter-double-double-", :inline-arities #{2}, :inline (fn [start direction] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.NextAfter (double (clojure.core/unquote start)) (double (clojure.core/unquote direction))))), :added "1.11"} ^{:tag double} [^{:tag double} start ^{:tag double} direction] (let [^{:tag double} start (double ^{:tag double} start) ^{:tag double} direction (double ^{:tag double} direction)] (github.com:glojurelang:glojure:pkg:javacompat:math.NextAfter start direction)))

(defn next-up {:doc "Returns the adjacent double of d in the direction of ##Inf.\n  If d is ##NaN => ##NaN\n  If d is ##Inf => ##Inf\n  If d is zero => Double/MIN_VALUE\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#nextUp-double-", :inline-arities #{1}, :inline (fn [d] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.NextUp (double (clojure.core/unquote d))))), :added "1.11"} ^{:tag double} [^{:tag double} d] (let [^{:tag double} d (double ^{:tag double} d)] (github.com:glojurelang:glojure:pkg:javacompat:math.NextUp d)))

(defn next-down {:doc "Returns the adjacent double of d in the direction of ##-Inf.\n  If d is ##NaN => ##NaN\n  If d is ##-Inf => ##-Inf\n  If d is zero => -Double/MIN_VALUE\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#nextDown-double-", :inline-arities #{1}, :inline (fn [d] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.NextDown (double (clojure.core/unquote d))))), :added "1.11"} ^{:tag double} [^{:tag double} d] (let [^{:tag double} d (double ^{:tag double} d)] (github.com:glojurelang:glojure:pkg:javacompat:math.NextDown d)))

(defn scalb {:doc "Returns d * 2^scaleFactor, scaling by a factor of 2. If the exponent\n  is between Double/MIN_EXPONENT and Double/MAX_EXPONENT, the answer is exact.\n  If d is ##NaN => ##NaN\n  If d is ##Inf or ##-Inf => ##Inf or ##-Inf respectively\n  If d is zero => zero of same sign as d\n  See: https://docs.oracle.com/javase/8/docs/api/java/lang/Math.html#nextDown-double-", :inline-arities #{2}, :inline (fn [d scaleFactor] (quote (github.com:glojurelang:glojure:pkg:javacompat:math.Scalb (double (clojure.core/unquote d)) (int (clojure.core/unquote scaleFactor))))), :added "1.11"} ^{:tag double} [^{:tag double} d scaleFactor] (let [^{:tag double} d (double ^{:tag double} d)] (github.com:glojurelang:glojure:pkg:javacompat:math.Scalb d (int scaleFactor))))

