(ns bench.constant-arithmetic)

(defn configured-step [value]
  (+ value
     (* (+ 2 3)
        (- 11 4))))

(defn count-input [value]
  (count value))

(defn local-counter []
  (let [state (atom 0)]
    (swap! state inc)
    (swap! state #(+ % 40))
    (reset! state (+ @state 1))
    @state))

(defn run []
  (loop [i 0
         total 0]
    (if (= i 1000000)
      total
      (recur (inc i)
             (configured-step total)))))

(def expected 35000000)
