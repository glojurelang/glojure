(ns bench.owned-vector)

(def values [[1 2] [3 4]])
(def pairs [[0 1] [1 0]])

(defn update-cell [matrix pair delta]
  (let [i (nth pair 0)
        j (nth pair 1)
        row (nth matrix i)]
    (assoc-in matrix [i j] (+ (nth row j) delta))))

(defn update-all [matrix updates delta]
  (let [updated
        (reduce
          (fn [state pair] (update-cell state pair delta))
          matrix
          updates)]
    (mapv
      (fn [row]
        (-> row
            (assoc 0 (+ (nth row 0) delta))
            (assoc 1 (+ (nth row 1) delta))))
      updated)))

(defn preserve-earlier-version [row]
  (-> row
      (assoc 0 20)
      (assoc 1 (nth row 0))))

(defn run []
  (update-all values pairs 10))

(def expected [[11 22] [23 14]])
