(ns glojure.test-glojure.deps
  (:require [clojure.test :refer [deftest is run-tests]]
            [clojurestar.deps :as portable-deps]
            [glojure.deps :as deps]
            [grenadine.coordinate :as coordinate]
            [grenadine.version :as version]))

(deftest embedded-grenadine-facade
  (let [coordinate {:mvn/version "1.0.0"}
        runtime-host
        {:getenv #(get {"GLOJURE_MAVEN_REPOSITORY" "/dialect/m2"
                        "GLOJURE_GITLIBS_CACHE" "/dialect/gitlibs"} %)}
        result
        (deps/add-deps
         {:deps {'example/library coordinate
                 'org.clojure/clojure {:mvn/version "1.12.4"}}}
         {:host runtime-host
          :install-fn
          (fn [libs opts]
            (is (= {'example/library coordinate} libs))
            (is (= runtime-host (:host opts)))
            (is (= "/dialect/m2" (:local-repo opts)))
            (is (= "/dialect/gitlibs" (:gitlibs-dir opts)))
            (is (= '#{org.clojure/clojure org.clojure/clojurescript}
                   (:provided-libs opts)))
            {:classpath [] :source-roots [] :warnings []})})]
    (is (= [] (:source-roots result)))
    (is (= coordinate
           (get-in (deps/current-basis) [:libs 'example/library])))))

(deftest portable-facade
  (is (nil? (portable-deps/add-deps {}))))

(deftest dependency-acquiring-facade
  (let [seen (atom [])]
    (with-redefs
     [deps/prepare-required!
      (fn [coordinate options]
        (swap! seen conj [(:coordinate coordinate) options])
        'grenadine.version)]
     (is (nil?
          (portable-deps/require-deps
           {:cache-dir "/cache"}
           '["gist:ingydotnet/f70409675d234aa4f2fe379cd975a4f5"
             :as required-version]
           '["mvn:example/library@1.0.0/example.library"
             :refer [compare-versions]])))
     (is (= ["gist:ingydotnet/f70409675d234aa4f2fe379cd975a4f5"
             "mvn:example/library@1.0.0/example.library"]
            (mapv first @seen)))
     (is (some? (resolve 'required-version/compare-versions)))
     (is (some? (resolve 'compare-versions))))))

(deftest embedded-grenadine-legacy-maven-forms
  (is (= ["hiccup" "hiccup" nil]
         (coordinate/split-lib 'hiccup)))
  (is (= ["org.lwjgl" "lwjgl-stb" "natives-macos"]
         (coordinate/split-lib 'org.lwjgl/lwjgl-stb$natives-macos)))
  (is (version/in-range? "1.9" "[1.0,2.0)"))
  (is (= "0.0.1-SNAPSHOT"
         (version/snapshot-base-version "0.0.1-20200715.082439-21"))))

(run-tests)
