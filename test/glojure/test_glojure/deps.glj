(ns glojure.test-glojure.deps
  (:require [clojure.test :refer [deftest is run-tests]]
            [clojurestar.deps :as portable-deps]
            [glojure.deps :as deps]
            [grenadine.coordinate :as coordinate]
            [grenadine.version :as version]))

(deftest embedded-grenadine-facade
  (let [coordinate {:mvn/version "1.0.0"}
        result
        (deps/add-deps
         {:deps {'example/library coordinate}}
         {:install-fn
          (fn [libs opts]
            (is (= {'example/library coordinate} libs))
            (is (map? (:host opts)))
            {:classpath [] :source-roots [] :warnings []})})]
    (is (= [] (:source-roots result)))
    (is (= coordinate
           (get-in (deps/current-basis) [:libs 'example/library])))))

(deftest portable-facade
  (is (nil? (portable-deps/add-deps {}))))

(deftest embedded-grenadine-legacy-maven-forms
  (is (= ["hiccup" "hiccup" nil]
         (coordinate/split-lib 'hiccup)))
  (is (= ["org.lwjgl" "lwjgl-stb" "natives-macos"]
         (coordinate/split-lib 'org.lwjgl/lwjgl-stb$natives-macos)))
  (is (version/in-range? "1.9" "[1.0,2.0)"))
  (is (= "0.0.1-SNAPSHOT"
         (version/snapshot-base-version "0.0.1-20200715.082439-21"))))

(run-tests)
