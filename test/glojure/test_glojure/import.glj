(ns glojure.test-glojure.import
  (:use clojure.test)
  (:import (strings TrimPrefix)
           (io Reader)))

(deftest Import
  (is (= "bar" (TrimPrefix "foobar" "foo"))))

(deftest RuntimeConstants
  (is (string? runtime.GOOS))
  (is (string? runtime.GOARCH))
  (is (seq runtime.GOOS))
  (is (seq runtime.GOARCH)))

(run-tests)
